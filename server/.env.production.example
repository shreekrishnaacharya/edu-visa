# Production env template for the Hostinger VPS deploy (docker-compose.prod.yml).
# Copy to `server/.env.production` ON THE VPS ONLY — never commit the real file,
# never scp it through a channel you wouldn't trust with the OpenRouter key,
# the PII encryption key, or the DB password.

# --- HTTP -------------------------------------------------------------------
PORT=3000
# The exact origin the frontend is served from (its own subdomain, see
# DEPLOYMENT.md) — the API rejects cross-origin requests from anywhere else.
CORS_ORIGIN=https://app.yourdomain.com

# --- Database (service name "db" — see docker-compose.prod.yml) ------------
DB_HOST=db
DB_PORT=5432
DB_USER=eduvisa
# MUST MATCH the value already in your local server/.env, NOT a fresh one.
# Postgres only applies POSTGRES_USER/PASSWORD when initializing an EMPTY data
# directory — ./docker/postgres ships already-initialized (real data bind-
# mounted from your dev machine, see DEPLOYMENT.md), so this password is
# ignored by Postgres itself; it only has to match what the DB already has, or
# the API's connection will fail. To actually change it, do so AFTER first
# boot with `ALTER USER eduvisa WITH PASSWORD '...'` inside the db container,
# then update this file to match.
DB_PASSWORD=eduvisa
DB_NAME=eduvisa
DB_SYNC=false
DB_LOGGING=false

# --- Auth --------------------------------------------------------------------
# Safe to generate fresh — only affects newly-issued tokens, no stored data
# depends on it (existing logins just get invalidated, harmless).
# generate: openssl rand -hex 32
JWT_SECRET=CHANGE-ME
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# --- PII encryption (32-byte key, hex or base64) ----------------------------
# MUST MATCH the value already in your local server/.env, NOT a fresh one —
# every passport/financial value already stored in ./docker/postgres was
# encrypted with that exact key; a different key here makes them permanently
# unreadable (not just on this deploy — there is no way to recover them
# without the original key). Copy it verbatim from local server/.env.
PII_ENC_KEY=CHANGE-ME

# --- Object storage (MinIO, service name "minio") ---------------------------
S3_ENDPOINT=minio
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=eduvisa
# generate: openssl rand -hex 24
S3_SECRET_KEY=CHANGE-ME
S3_BUCKET=eduvisa-docs

# --- Matching engine ---------------------------------------------------------
ENGINE_VERSION=v1.0.0

# --- Release scope ------------------------------------------------------------
ACTIVE_COUNTRIES=AU

# --- Redis (service name "redis") --------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- Rate limiting -------------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=10

# --- AI consultant (OpenRouter) ------------------------------------------------
# Copy the real key from your local server/.env — do not generate a new one.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=google/gemma-4-26b-a4b-it
OPENROUTER_CHAT_MODEL_FALLBACK=google/gemma-4-26b-a4b-it:free
OPENROUTER_ROUTER_MODEL=google/gemma-3-4b-it
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
OPENROUTER_MIN_BALANCE_USD=0.5
